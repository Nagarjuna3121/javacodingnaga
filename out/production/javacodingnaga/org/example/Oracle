Print department wise max salary in sql:
========================================

ELECT dept_name,
       emp_name,
       salary
FROM (
  SELECT d.dept_name,
         e.emp_name,
         e.salary,
         RANK() OVER (PARTITION BY e.dept_id ORDER BY e.salary DESC) AS rnk
  FROM employee e
  JOIN department d
    ON e.dept_id = d.dept_id
)
WHERE rnk = 1
ORDER BY dept_name;


